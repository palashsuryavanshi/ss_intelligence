<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy model: SS Intelligence is local-only. There is deliberately NO
      INTERNET permission: the app cannot exfiltrate screenshots or OCR text
      even if a future bug tried to. All processing is on-device.
    -->

    <!--
      ML Kit's transitive dependencies declare INTERNET for their optional
      telemetry upload path. This app has no telemetry, so the permission is
      explicitly removed from the merged manifest. See README "Privacy model".
    -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Android 13+ (API 33): granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 10-12 (API 29-32): legacy storage read for MediaStore discovery -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Calendar write for automation rules (§29) -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".SsIntelligenceApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SSIntelligence">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SSIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Internal deep links (§56): ssi://screenshot/{id}, ssi://entity/{id},
                 ssi://collection/{id}, ssi://search, ssi://assistant, ssi://browse,
                 ssi://insights. Handled in-app; never parsed as arbitrary URLs. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ssi" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home screen widget (§53) -->
        <receiver
            android:name=".widget.SsIntelligenceWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ss_intelligence" />
        </receiver>

        <!-- WorkManager on-demand initialization (configured in SsIntelligenceApp) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
