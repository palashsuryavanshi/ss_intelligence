<!--
  Adaptive launcher icon foreground: a magnifier over stacked screenshots.
  Uses only <path> elements so the icon renders on every API level without
  needing <shape> drawables or API-gated attributes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back sheet -->
    <path
        android:fillColor="#7FB3FF"
        android:pathData="M28,32h34v46h-34z" />

    <!-- Front sheet -->
    <path
        android:fillColor="#E8EEF7"
        android:pathData="M40,26h34v46h-34z" />

    <!-- Text lines on the front sheet -->
    <path
        android:fillColor="#0B1D3A"
        android:pathData="M45,34h24v4h-24z M45,43h18v4h-18z M45,52h22v4h-22z" />

    <!-- Magnifier ring -->
    <path
        android:strokeColor="#7FB3FF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:pathData="M57,54m-13,0a13,13 0,1 1,26 0a13,13 0,1 1,-26 0" />

    <!-- Magnifier handle -->
    <path
        android:strokeColor="#7FB3FF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M66,63 L78,75" />
</vector>
